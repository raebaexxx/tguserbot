[Unit]
Description=Telegram userbot with plugin manager
After=network-online.target
Wants=network-online.target
# The bot refuses to start without an authorized session, so a crash loop here
# would only spam the journal and risk a Telegram rate limit on the account.
StartLimitIntervalSec=300
StartLimitBurst=5
# systemd gives up after StartLimitBurst failures and the bot then stays down
# silently. Notify the owner first, then let systemd do its job. Set
# TGUSERBOT_ALERT_CHAT in userbot.env to enable; without it the hook exits 0.
# OnFailure= belongs to [Unit], not [Service]; systemd ignores it in [Service]
# without an error, which is how this went unnoticed.
OnFailure=tguserbot-alert@%n.service

[Service]
Type=notify
NotifyAccess=main
User=tguserbot
Group=tguserbot
WorkingDirectory=/opt/tguserbot
EnvironmentFile=/etc/tguserbot/userbot.env
ExecStart=/opt/tguserbot/.venv/bin/python -m userbot run
Restart=on-failure
RestartSec=15
# The app must call sd_notify at least every WatchdogSec/2 or systemd restarts it.
# It does so from the same heartbeat that health monitoring reads, so the two
# cannot drift apart. Outside systemd WATCHDOG_PID is unset and the ping is
# skipped, so no switch is needed to turn it off.
#
# The process stops feeding the watchdog if Telegram stays unreachable for
# DISCONNECT_GRACE seconds (see src/userbot/app.py), so that a session revoked
# server-side ends in a restart and a reported error rather than a healthy-looking
# service that answers nothing. That grace must stay below WatchdogSec.
WatchdogSec=60
# The app bounds its own shutdown with one shared deadline (see
# SHUTDOWN_TIMEOUT in userbot/app.py). This must stay above that value so the
# process is never SIGKILLed mid-unload; the old 30s was below the worst case.
TimeoutStopSec=120
UMask=0077

# A 50 MiB plugin download lands in a tmpfs, so cap memory rather than letting
# the box swap.
MemoryMax=1G
TasksMax=256
LimitNOFILE=4096

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# TGUSERBOT_PLUGIN_DIR defaults to /opt/tguserbot/plugins, which ProtectSystem
# makes read-only. The watcher hot-reloads from it anyway: it only reads, and the
# loader compiles the sources in memory. Python declines to write __pycache__ into
# a directory it cannot write and imports regardless -- the bytecode cache is an
# optimisation, not a requirement. So hot reload needs no extra access here.
#
# This comment previously said the opposite, which sent operators pointing
# TGUSERBOT_PLUGIN_DIR at a second copy of their plugins on writable storage, so
# that the tree they edited and the tree the bot loaded were two directories.
# tests/test_deploy.py loads a plugin from a chmod 555 directory to keep it true.
ReadWritePaths=/var/lib/tguserbot

[Install]
WantedBy=multi-user.target
