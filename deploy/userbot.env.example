# Copy to /etc/tguserbot/userbot.env and set values there.
# This file is read by systemd's EnvironmentFile, so every line must be
# KEY=VALUE. Quote values that contain spaces.
TGUSERBOT_API_ID=
TGUSERBOT_API_HASH=
TGUSERBOT_PHONE=
TGUSERBOT_OWNER_IDS=

TGUSERBOT_DATA_DIR=/var/lib/tguserbot
# ProtectSystem=strict makes /opt/tguserbot read-only, so the local-plugin
# watcher cannot fire with this default. Point it at a writable directory to
# enable hot reload, e.g. /var/lib/tguserbot/plugins.
TGUSERBOT_PLUGIN_DIR=/opt/tguserbot/plugins
TGUSERBOT_LOG_DIR=/var/lib/tguserbot/logs
TGUSERBOT_LOG_LEVEL=INFO

TGUSERBOT_WATCH=1
TGUSERBOT_WATCH_INTERVAL=2.0
TGUSERBOT_COMMAND_TIMEOUT=120
TGUSERBOT_LOG_JSON=0
TGUSERBOT_FLOOD_THRESHOLD=60
TGUSERBOT_MIN_INTERVAL=0.5

# Telegram chat ID to notify when the service dies and systemd stops
# restarting it (see deploy/alert.sh). Leave empty to disable.
TGUSERBOT_ALERT_CHAT=
# Google AI Studio API key for the `ai` plugin. Comma-separate several
# to rotate through them when one hits a rate limit. NEVER commit a key.
# Get one at https://aistudio.google.com/api-keys
TGUSERBOT_GEMINI_API_KEY=


TGUSERBOT_GIT_ALLOWED_REPOS=https://github.com/raebaexxx/tguserbot.git
