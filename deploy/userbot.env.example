# Copy to /etc/tguserbot/userbot.env and set values there.
TGUSERBOT_API_ID=
TGUSERBOT_API_HASH=
TGUSERBOT_PHONE=
TGUSERBOT_OWNER_IDS=
TGUSERBOT_DATA_DIR=/var/lib/tguserbot
TGUSERBOT_PLUGIN_DIR=/opt/tguserbot/plugins
TGUSERBOT_LOG_LEVEL=INFO
TGUSERBOT_GIT_ALLOWED_REPOS=https://github.com/raebaexxx/tguserbot.git
