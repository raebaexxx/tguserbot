# Required Telegram application credentials from https://my.telegram.org/apps
TGUSERBOT_API_ID=
TGUSERBOT_API_HASH=

# Optional. If omitted, the first interactive login asks for the phone number.
TGUSERBOT_PHONE=

# Comma-separated Telegram user IDs allowed to manage plugins.
# The logged-in account is always added automatically.
# A plugin listed here cannot be re-enabled at runtime; remove it here first.
TGUSERBOT_OWNER_IDS=

# Comma-separated plugins that must never load. Useful for keeping the demo
# plugins out of a production install.
TGUSERBOT_DISABLED_PLUGINS=

# Project root used when neither --root nor TGUSERBOT_APP_DIR is given.
# Defaults to the current working directory.
TGUSERBOT_ROOT=

# Values reported to Telegram as the client identity. Change them if you run
# more than one account from this deployment.
TGUSERBOT_DEVICE_MODEL=tguserbot
TGUSERBOT_APP_VERSION=0.1.0

# Runtime paths. Defaults are suitable for the systemd deployment.
TGUSERBOT_DATA_DIR=/var/lib/tguserbot
TGUSERBOT_PLUGIN_DIR=/opt/tguserbot/plugins
TGUSERBOT_LOG_DIR=/var/lib/tguserbot/logs
TGUSERBOT_LOG_LEVEL=INFO

# Local plugin hot-reload. Under the shipped systemd unit TGUSERBOT_PLUGIN_DIR
# is read-only, so the watcher cannot fire there; point it at a writable path
# (for example /var/lib/tguserbot/plugins) to enable it.
# 0/false/no/off disables the watcher entirely.
TGUSERBOT_WATCH=1
# Seconds between directory scans. The scan reads file metadata and only
# re-hashes a plugin whose size or mtime changed.
TGUSERBOT_WATCH_INTERVAL=2.0

# Per-command limits. A command that runs longer than this is reported as
# timed out; repeated invocations within the cooldown are rejected.
TGUSERBOT_COMMAND_TIMEOUT=120

# Set to 1 for one JSON object per log line (for journald shippers).
TGUSERBOT_LOG_JSON=0

# Telegram flood handling. A negative flood threshold turns every FloodWait
# into an exception, so keep this at or above zero. A very large value turns a
# multi-hour flood wait into a process-wide sleep.
TGUSERBOT_FLOOD_THRESHOLD=60

# Minimum seconds between operations that share a rate-limit key.
TGUSERBOT_MIN_INTERVAL=0.5

# Telegram chat ID to notify when the service dies and systemd stops
# restarting it (see deploy/alert.sh). Leave empty to disable.
TGUSERBOT_ALERT_CHAT=

# Comma-separated exact repository URLs accepted by the Git plugin source.
# Comparison ignores case and an optional .git suffix. Leave empty until
# remote Git plugins are needed.
TGUSERBOT_GIT_ALLOWED_REPOS=https://github.com/raebaexxx/tguserbot.git
