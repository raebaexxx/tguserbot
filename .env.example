# Required Telegram application credentials from https://my.telegram.org/apps
TGUSERBOT_API_ID=
TGUSERBOT_API_HASH=

# Optional. If omitted, the first interactive login asks for the phone number.
TGUSERBOT_PHONE=

# Comma-separated Telegram user IDs allowed to manage plugins.
# The logged-in account is always added automatically.
TGUSERBOT_OWNER_IDS=

# Runtime paths. Defaults are suitable for the systemd deployment.
TGUSERBOT_DATA_DIR=/var/lib/tguserbot
TGUSERBOT_PLUGIN_DIR=/opt/tguserbot/plugins
TGUSERBOT_LOG_LEVEL=INFO

# Comma-separated exact repository URLs accepted by the Git plugin source.
# Leave empty until remote Git plugins are needed.
TGUSERBOT_GIT_ALLOWED_REPOS=https://github.com/raebaexxx/tguserbot.git
